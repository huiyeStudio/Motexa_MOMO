{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["accent", "hideSpeedDecimal", "showPower", "animationStyle"],
  "properties": {
    "accent": { "type": "string", "enum": ["lime", "cyan", "amber", "purple", "orange"] },
    "hideSpeedDecimal": { "type": "boolean" },
    "showPower": { "type": "boolean" },
    "animationStyle": { "type": "string", "enum": ["smooth", "energetic", "minimal"] }
  }
}
